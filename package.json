{
  "name": "gdfinder",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.19.x",
    "npm": "11.17.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:create": "wrangler d1 create gdfinder",
    "db:migrate": "wrangler d1 migrations apply gdfinder",
    "db:migrate:local": "wrangler d1 migrations apply gdfinder --local"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
